{
  "version": "1.0.1",
  "keywords": [
    "strapi",
    "turbo-red",
    "TurboRED",
    "strapi-plugin",
    "strapi-v5",
    "plugin"
  ],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test:ts:front": "run -T tsc -p admin/tsconfig.json",
    "test:ts:back": "run -T tsc -p server/tsconfig.json"
  },
  "dependencies": {
    "@strapi/design-system": "^2.2.0",
    "@strapi/icons": "^2.2.0",
    "react-intl": "^10.0.0"
  },
  "devDependencies": {
    "@strapi/sdk-plugin": "^6.0.1",
    "@strapi/strapi": "^5.40.0",
    "@strapi/typescript-utils": "^5.40.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "styled-components": "^6.3.0",
    "typescript": "^5.6.3",
    "vite-plugin-svgr": "^4.2.0"
  },
  "peerDependencies": {
    "@strapi/strapi": "5.x",
    "react": "19.x",
    "react-dom": "19.x",
    "react-router-dom": "7.x",
    "styled-components": "6.x"
  },
  "strapi": {
    "kind": "plugin",
    "name": "lookup-enum",
    "displayName": "TurboRED Lookup Enum",
    "description": "Like enum field, but options are extracted from a field provided by a single-type content."
  },
  "name": "@turbo-red/strapi-plugin-lookup-enum",
  "description": "Like enum field, but options are extracted from a field provided by a single-type content.",
  "license": "MIT",
  "author": "Andrea Chiumenti <achiumenti@red.software.systems>",
  "repository": {
    "type": "git",
    "url": "https://github.com/turbo-red/strapi-plugin-lookup-enum.git"
  },
  "packageManager": "yarn@4.13.0"
}
